# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Esytol

# ─── Analytics (optional) ────────────────────────────────────────────────────
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity project ID (e.g. xxxxxxxxxx)
NEXT_PUBLIC_CLARITY_ID=

# ─── Ads (optional) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_ADSENSE_ID=

# ─── Admin access (P0-2) ─────────────────────────────────────────────────────
# HTTP Basic credentials for every /admin route, enforced by middleware.ts.
# FAIL-CLOSED: while these are unset, /admin returns 401 for EVERYONE (including
# you). Set both in the deployment environment to unlock the dashboards.
# Server-side only — never NEXT_PUBLIC, never committed.
ADMIN_USER=
ADMIN_PASSWORD=

# ─── Growth Dashboard providers (/admin/growth) ──────────────────────────────
# Each provider goes live when its variables are set; otherwise the dashboard
# shows honest empty datasets (real blanks, never fabricated numbers — see
# lib/growth/empty.ts, which replaced the old sample data in P0-3). Server-side
# only — never commit real secrets.

# Google Analytics (GA4) via a Google Service Account:
#   1. Create a Service Account in Google Cloud, download its JSON key.
#   2. In GA4 Admin → Property Access, grant the service-account email "Viewer".
#   3. Set the numeric property ID and provide the key (file path OR inline):
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# Or a pre-minted OAuth token instead of a Service Account:
# GOOGLE_ACCESS_TOKEN=

# Google Search Console — uses the SAME service account as GA4. Grant its
# client_email access under Search Console → Settings → Users, then set the
# property URL exactly as registered (e.g. sc-domain:esytol.com or https://www.esytol.com/):
GSC_SITE_URL=
# Microsoft Clarity
CLARITY_API_TOKEN=
# GitHub
GITHUB_TOKEN=
GITHUB_REPO=EasyTechLabs/esytol
# Vercel
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ─── Vyora development Party API reads (VYORA-PLATFORM-005) ──────────────────
# Development convenience ONLY. Reads a locally running vyora-api so a
# developer can check the API returns what the web app expects.
#
# DEFAULT: disabled. Leave it disabled unless you are actively testing the API.
# The pilot experience must not change, and this flag is not a migration.
#
# Three conditions must ALL hold before any remote read happens:
#   1. this flag is exactly "true";
#   2. the build is not a production build — a production build ignores it;
#   3. NEXT_PUBLIC_VYORA_API_URL is loopback.
NEXT_PUBLIC_VYORA_API_PARTY_READS_ENABLED=false
NEXT_PUBLIC_VYORA_API_URL=http://127.0.0.1:4000

# The development identity sent to vyora-api. Server-side ONLY: it is read by
# the /api/vyora-dev/parties proxy and never inlined into a client bundle.
# NEVER give this a NEXT_PUBLIC_ prefix — that would publish the credential.
VYORA_API_DEV_IDENTITY=
