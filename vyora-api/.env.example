# Vyora API — local development only. Copy to .env and adjust.
# Never put a real credential, a remote host, or a production URL in here.

NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Local PostgreSQL. A non-loopback host is refused at startup.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/vyora

# Development identity scheme (X-Vyora-Dev-Identity).
# Setting this to true while NODE_ENV=production makes the process exit non-zero.
VYORA_DEV_AUTH=true

# Signs sync cursors so a cursor from another server is detectable.
SYNC_CURSOR_SECRET=local-development-only-not-a-secret

# Events older than this are outside the pull window; a cursor pointing
# before it returns SYNC_CURSOR_EXPIRED.
SYNC_RETENTION_DAYS=90

# Envelope versions accepted on push.
SYNC_SCHEMA_VERSION=1
SYNC_MIN_SCHEMA_VERSION=1
SYNC_MAX_BATCH_EVENTS=500
